# Entity: economic_development

main: kit: entity: economic_development: {

  alias: field: {}

  fields: [
    {
      name: "industries"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "initiatives"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "resources"
      req: false
      type: "`$ARRAY`"
    }
  ]

  name: "economic_development"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/business/economic-development"
          segments: [
            {
              lit: "business"
            }
            {
              lit: "economic-development"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
