# Entity: city_info

main: kit: entity: city_info: {

  alias: field: {}

  fields: [
    {
      name: "address"
      req: false
      type: "`$STRING`"
    }
    {
      name: "annualVisitors"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "established"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "numberOfParks"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "phone"
      req: false
      type: "`$STRING`"
    }
    {
      name: "squareMiles"
      req: false
      type: "`$NUMBER`"
    }
  ]

  name: "city_info"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/city-info"
          parts: [
            "city-info"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
